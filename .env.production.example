# Copy this file to .env.production and replace every change-me/example value.
# Never commit .env.production.  OIDC remains fail-closed until it is valid.

POSTGRES_DB=pvweb
POSTGRES_USER=pvweb
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
# Set PVWEB_DATABASE_URL explicitly when using an external PostgreSQL service.
# Password characters reserved by URLs must be percent-encoded.
# PVWEB_DATABASE_URL=postgresql+psycopg://pvweb:password@db.example.com:5432/pvweb

MINIO_ROOT_USER=pvweb-minio
MINIO_ROOT_PASSWORD=change-me-object-store-password
MINIO_BIND_ADDRESS=127.0.0.1
PVWEB_S3_BUCKET=pvweb
PVWEB_S3_REGION=us-east-1
PVWEB_S3_CACHE_MAX_BYTES=5368709120
PVWEB_S3_CACHE_TTL_SECONDS=86400
PVWEB_S3_PRESIGNED_DOWNLOADS=0

PVWEB_WEB_BIND_ADDRESS=127.0.0.1
PVWEB_WEB_PORT=8080
PVWEB_ROOT_PATH=/api
PVWEB_AUTH_MODE=oidc
PVWEB_ALLOW_INSECURE_DEV_AUTH=0
PVWEB_OIDC_ISSUER=https://identity.example.com/realms/pvweb
PVWEB_OIDC_AUDIENCE=pvweb-api
PVWEB_OIDC_JWKS_URL=https://identity.example.com/realms/pvweb/protocol/openid-connect/certs
PVWEB_BOOTSTRAP_ADMIN_SUBS=
PVWEB_CORS_ORIGINS=https://pvweb.example.com

VITE_OIDC_AUTHORITY=https://identity.example.com/realms/pvweb
VITE_OIDC_CLIENT_ID=pvweb-ui
VITE_OIDC_REDIRECT_URI=https://pvweb.example.com/

PVWEB_MAX_UPLOAD_BYTES=536870912
PVWEB_MAX_ARTIFACT_BYTES=33554432
PVWEB_AUDIT_LIST_LIMIT=500
PVWEB_JOB_STREAM_MAX_SECONDS=300
PVWEB_WORKER_TIMEOUT=900
PVWEB_SESSION_TTL=3600

# The full-stack profile runs a durable Redis/RQ queue by default. Use an
# externally managed Redis URL here when Redis is not deployed by Compose.
PVWEB_JOB_QUEUE_BACKEND=rq
PVWEB_REDIS_URL=redis://redis:6379/0
PVWEB_JOB_QUEUE_NAME=pvweb
PVWEB_JOB_QUEUE_TIMEOUT=3600
PVWEB_JOB_QUEUE_RESULT_TTL=86400
PVWEB_JOB_QUEUE_FAILURE_TTL=604800
PVWEB_JOB_QUEUE_MAX_RETRIES=3
PVWEB_JOB_QUEUE_RETRY_INTERVAL=10

# Optional capabilities are disabled unless explicitly supplied by an image
# extension/deployment that actually contains pvpython or a reachable broker.
# PVWEB_PVPYTHON=/opt/paraview/bin/pvpython
# PVWEB_TRAME_BROKER_URL=http://trame-broker:9002
# PVWEB_TRAME_BROKER_TOKEN=change-me
# PVWEB_TRAME_ALLOWED_WS_HOSTS=trame-broker
